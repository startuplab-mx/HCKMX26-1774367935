<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.requiemz.overlay_pop_up">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".OverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Transparent Activity for starting overlay service from background on Android 12+ -->
        <activity
            android:name=".OverlayLauncherActivity"
            android:enabled="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:taskAffinity=""
            android:screenOrientation="portrait" />
    </application>
</manifest>
